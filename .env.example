# === Twilio (WhatsApp messaging) ===
# Sign up: https://console.twilio.com -> Messaging -> Try it out -> WhatsApp sandbox
# Used by: bot/ai_client.py (to auth voice-note downloads), api/index.py (webhook parsing)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# === Google Gemini ===
# Sign up (free, no card): https://aistudio.google.com/apikey
# Used by: bot/ai_client.py
# Before deploying for real, check https://ai.google.dev/gemini-api/docs/models
# for currently-available model IDs -- this build defaults to gemini-2.5-flash,
# the one model verified working at build time, but Gemini's lineup moves fast.
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_CLASSIFY_MODEL=gemini-2.5-flash

# === Upstash Redis (serverless, conversation memory) ===
# Sign up (free tier, 500K commands/mo): https://console.upstash.com
# Create Database -> REST API tab -> copy URL + token
# Used by: bot/memory.py -- if unset, memory.py transparently falls back to an
# in-memory dict so the bot is still fully testable locally without this.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Gmail SMTP (human handoff email) ===
# Requires 2-Step Verification enabled first: https://myaccount.google.com/security
# Then generate an App Password: https://myaccount.google.com/apppasswords
# Used by: bot/handoff.py -- if unset, escalation just logs a warning and the
# webhook still replies normally (never crashes on missing mail config).
GMAIL_USER=
GMAIL_APP_PASSWORD=
AGENT_EMAIL=

# === Admin dashboard auth ===
# HTTP Basic Auth protects /admin/* (any username, this password). Unset
# means /admin is closed entirely (401), not left open.
# Used by: dashboard/routes.py
ADMIN_PASSWORD=

# === Bot config ===
BOT_NAME=SupportBot
MAX_HISTORY_MESSAGES=10
ESCALATION_KEYWORDS=refund,complaint,manager,urgent,broken,angry
